{
  "rewrites": [
    {
      "source": "/__l5e/:path*",
      "destination": "https://photobooth-blessed-frames.lovable.app/__l5e/:path*"
    },
    {
      "source": "/((?!.*\\.(?:png|jpg|jpeg|gif|webp|svg|ico|css|js|mp4|webm)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/__l5e/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
